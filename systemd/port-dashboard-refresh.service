[Unit]
Description=Refresh port dashboard data
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/port-dashboard
ExecStart=/usr/bin/bash -lc '${PORT_DASHBOARD_DIR}/scripts/refresh-data.sh'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target




